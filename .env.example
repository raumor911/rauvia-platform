# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# WordPress Blog Integration (Optional overrides)
VITE_WORDPRESS_PUBLIC_URL=https://blog.rauvia.com.mx
VITE_WORDPRESS_API_URL=https://blog.rauvia.com.mx/wp-json/wp/v2

# MySQL Database Configuration (Server-side only; never exposed to the client)
DB_HOST=srv1999.hstgr.io
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# IndexNow (server-side; opt-in only in NODE_ENV=production)
INDEXNOW_ENABLED=false
INDEXNOW_KEY=1109c92c84549878ea17f221eaba40bc
# Separate random secret, at least 32 characters; match wp-config.php.
INDEXNOW_WEBHOOK_TOKEN=
# Set to persistent storage OUTSIDE hbuilds/current and outside public_html.
# Example for the verified Hostinger account; create the directory with mode 700.
INDEXNOW_STATE_PATH=/home/u345974778/domains/rauvia.com.mx/private/indexnow-state.json
INDEXNOW_BATCH_SIZE=1000
INDEXNOW_TIMEOUT_MS=5000
# Explicit initial submission only; otherwise the first snapshot is a baseline.
INDEXNOW_SUBMIT_INITIAL=false
# Existing sitemap cadence is preserved: default 21600000 (6 hours).
# Use 43200000 explicitly if a 12-hour interval is desired.
# SITEMAP_REFRESH_INTERVAL_MS=21600000

