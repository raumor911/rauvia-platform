{
  "name": "react-example",
  "private": true,
  "version": "76.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node --import tsx scripts/build-knowledge-graph.js && node --import tsx scripts/build-retrieval.js && vite build && node scripts/prerender.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --loader:.css=empty --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "geo:check": "tsx scripts/run-geo-checks.ts",
    "audit:seo": "node scripts/seo-audit.js",
    "audit:entities": "node --import tsx scripts/entity-audit.js",
    "audit:content": "node scripts/content-audit.js",
    "audit:authority": "node scripts/authority-audit.js",
    "audit:llmo": "node scripts/llmo-audit.js",
    "audit:migration": "node scripts/phase-0-migration-audit.js",
    "test:seo": "node --import tsx --test tests/wordpress-cache.test.ts tests/ruta90-events.test.ts && node --test tests/seo-html.test.mjs tests/ruta90.test.mjs",
    "test:favicon": "node --test tests/favicon.test.mjs",
    "test:ruta90-integration": "node --import tsx --test tests/ruta90-events.test.ts && node --test tests/ruta90-integration.test.mjs",
    "test:aethryon": "node --import tsx --test tests/aethryon-events.test.ts && node --test tests/aethryon-ux.test.mjs",
    "test:v73": "node --test tests/v73-stabilization.test.mjs tests/v73-browser-evidence.test.mjs",
    "build:knowledge": "node --import tsx scripts/build-knowledge-graph.js",
    "audit:knowledge": "node --import tsx scripts/knowledge-audit.js",
    "test:knowledge": "node --import tsx --test tests/knowledge.test.ts tests/person-knowledge.test.ts tests/person-practice.test.ts",
    "test:knowledge-http": "node --test tests/knowledge-http.test.mjs",
    "build:retrieval": "node --import tsx scripts/build-retrieval.js",
    "audit:retrieval": "node --import tsx scripts/retrieval-audit.js",
    "test:retrieval": "node --import tsx --test tests/retrieval.test.ts tests/v75-security.test.ts tests/v75-http.test.mjs",
    "test:person-knowledge": "node --import tsx --test tests/person-knowledge.test.ts tests/person-practice.test.ts",
    "test:retrieval-backend": "node --import tsx --test tests/retrieval.test.ts",
    "audit:retrieval-backend": "node --import tsx scripts/retrieval-backend-audit.js",
    "typecheck:knowledge": "tsc -p tsconfig.knowledge.json",
    "test:indexnow": "node --test tests/indexnow.test.mjs tests/indexnow-app.test.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --loader:.css=empty --outfile=dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "entities": "^7.0.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.3",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "brace-expansion": "5.0.12",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
